!output/tables/.gitkeep
!output/reports/.gitkeep

# LaTeX build artefacts (keep sources and generated/ tables)
tex/*.aux
tex/*.log
tex/*.out
tex/*.toc
tex/*.nav
tex/*.snm
tex/*.vrb
tex/*.bbl
tex/*.blg
tex/*.synctex.gz
